{
  "name": "pubspec-master",
  "displayName": "Moinsen Pubspec Master",
  "description": "Flutter/Dart monorepo management by Moinsen - Dashboard, dependency graph, migration tools, and private package support",
  "version": "0.15.0",
  "publisher": "moinsen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moinsen-dev/moinsen-pubspec-master"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "flutter",
    "dart",
    "pubspec",
    "monorepo",
    "workspace",
    "dependency",
    "package"
  ],
  "icon": "media/icons/pubspec-master.png",
  "activationEvents": [
    "workspaceContains:**/pubspec.yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pubspec-master",
          "title": "Pubspec Master",
          "icon": "media/icons/pubspec-master.svg"
        }
      ]
    },
    "views": {
      "pubspec-master": [
        {
          "id": "pubspecMaster.dashboard",
          "name": "Packages",
          "icon": "$(package)"
        }
      ]
    },
    "commands": [
      {
        "command": "pubspecMaster.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Pubspec Master"
      },
      {
        "command": "pubspecMaster.pubGetAll",
        "title": "Run Pub Get (All Packages)",
        "icon": "$(cloud-download)",
        "category": "Pubspec Master"
      },
      {
        "command": "pubspecMaster.pubUpgradeAll",
        "title": "Run Pub Upgrade (All Packages)",
        "icon": "$(cloud-upload)",
        "category": "Pubspec Master"
      },
      {
        "command": "pubspecMaster.openPubspec",
        "title": "Open pubspec.yaml",
        "icon": "$(go-to-file)",
        "category": "Pubspec Master"
      },
      {
        "command": "pubspecMaster.pubGet",
        "title": "Run Pub Get",
        "icon": "$(cloud-download)",
        "category": "Pubspec Master"
      },
      {
        "command": "pubspecMaster.pubUpgrade",
        "title": "Run Pub Upgrade",
        "icon": "$(cloud-upload)",
        "category": "Pubspec Master"
      },
      {
        "command": "pubspecMaster.showDashboard",
        "title": "Show Dashboard",
        "icon": "$(dashboard)",
        "category": "Pubspec Master"
      },
      {
        "command": "pubspecMaster.showGraph",
        "title": "Show Dependency Graph",
        "icon": "$(type-hierarchy)",
        "category": "Pubspec Master"
      },
      {
        "command": "pubspecMaster.fixConflict",
        "title": "Fix Version Conflict",
        "icon": "$(wand)",
        "category": "Pubspec Master"
      },
      {
        "command": "pubspecMaster.fixSdkMismatch",
        "title": "Fix SDK Mismatch",
        "icon": "$(wand)",
        "category": "Pubspec Master"
      },
      {
        "command": "pubspecMaster.syncAllVersions",
        "title": "Sync All Versions",
        "icon": "$(sync)",
        "category": "Pubspec Master"
      },
      {
        "command": "pubspecMaster.expandAll",
        "title": "Expand All",
        "icon": "$(expand-all)",
        "category": "Pubspec Master"
      },
      {
        "command": "pubspecMaster.showMigrationWizard",
        "title": "Migration Wizard",
        "icon": "$(wand)",
        "category": "Pubspec Master"
      },
      {
        "command": "pubspecMaster.createConfig",
        "title": "Create Configuration File",
        "icon": "$(new-file)",
        "category": "Pubspec Master"
      },
      {
        "command": "pubspecMaster.openConfig",
        "title": "Open Configuration File",
        "icon": "$(settings-gear)",
        "category": "Pubspec Master"
      },
      {
        "command": "pubspecMaster.toggleViewMode",
        "title": "Toggle View Mode",
        "icon": "$(list-tree)",
        "category": "Pubspec Master"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pubspecMaster.refresh",
          "when": "view == pubspecMaster.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "pubspecMaster.showDashboard",
          "when": "view == pubspecMaster.dashboard",
          "group": "navigation@2"
        },
        {
          "command": "pubspecMaster.showGraph",
          "when": "view == pubspecMaster.dashboard",
          "group": "navigation@3"
        },
        {
          "command": "pubspecMaster.toggleViewMode",
          "when": "view == pubspecMaster.dashboard",
          "group": "navigation@4"
        },
        {
          "command": "pubspecMaster.expandAll",
          "when": "view == pubspecMaster.dashboard",
          "group": "navigation@9"
        },
        {
          "command": "pubspecMaster.pubGetAll",
          "when": "view == pubspecMaster.dashboard",
          "group": "2_pubcommands@1"
        },
        {
          "command": "pubspecMaster.pubUpgradeAll",
          "when": "view == pubspecMaster.dashboard",
          "group": "2_pubcommands@2"
        },
        {
          "command": "pubspecMaster.showMigrationWizard",
          "when": "view == pubspecMaster.dashboard",
          "group": "3_tools@1"
        }
      ],
      "view/item/context": [
        {
          "command": "pubspecMaster.openPubspec",
          "when": "view == pubspecMaster.dashboard && viewItem == package",
          "group": "inline"
        },
        {
          "command": "pubspecMaster.pubGet",
          "when": "view == pubspecMaster.dashboard && viewItem == package",
          "group": "commands@1"
        },
        {
          "command": "pubspecMaster.pubUpgrade",
          "when": "view == pubspecMaster.dashboard && viewItem == package",
          "group": "commands@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pubspecMaster.showDashboard",
        "key": "ctrl+shift+p d",
        "mac": "cmd+shift+p d",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "pubspecMaster.showGraph",
        "key": "ctrl+shift+p g",
        "mac": "cmd+shift+p g",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "pubspecMaster.refresh",
        "key": "ctrl+shift+p r",
        "mac": "cmd+shift+p r",
        "when": "view == pubspecMaster.dashboard"
      },
      {
        "command": "pubspecMaster.pubGetAll",
        "key": "ctrl+shift+p i",
        "mac": "cmd+shift+p i",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "pubspecMaster.pubUpgradeAll",
        "key": "ctrl+shift+p u",
        "mac": "cmd+shift+p u",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "pubspecMaster.showMigrationWizard",
        "key": "ctrl+shift+p m",
        "mac": "cmd+shift+p m",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "pubspecMaster.syncAllVersions",
        "key": "ctrl+shift+p s",
        "mac": "cmd+shift+p s",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "configuration": {
      "title": "Moinsen Pubspec Master",
      "properties": {
        "pubspecMaster.scan.excludePatterns": {
          "type": "array",
          "default": [
            "**/build/**",
            "**/.dart_tool/**",
            "**/ios/Pods/**",
            "**/android/.gradle/**",
            "**/test/fixtures/**"
          ],
          "description": "Glob patterns to exclude from workspace scanning"
        },
        "pubspecMaster.scan.maxDepth": {
          "type": "number",
          "default": 10,
          "description": "Maximum directory depth for pubspec.yaml discovery"
        },
        "pubspecMaster.dashboard.refreshOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Auto-refresh dashboard when pubspec.yaml files are saved"
        },
        "pubspecMaster.dashboard.viewMode": {
          "type": "string",
          "enum": [
            "hierarchical",
            "logical"
          ],
          "default": "hierarchical",
          "enumDescriptions": [
            "Group packages by folder structure (example/ → apps/ → admin_app)",
            "Group by type: Apps and Packages categories"
          ],
          "description": "How to organize packages in the tree view"
        },
        "pubspecMaster.cache.ttlMinutes": {
          "type": "number",
          "default": 15,
          "description": "Cache duration for pub.dev API responses (in minutes)"
        },
        "pubspecMaster.cache.offlineMaxHours": {
          "type": "number",
          "default": 24,
          "description": "Maximum age of cached data for offline mode (in hours)"
        },
        "pubspecMaster.sync.createBackup": {
          "type": "boolean",
          "default": true,
          "description": "Create backup before applying version sync changes"
        },
        "pubspecMaster.sync.backupLocation": {
          "type": "string",
          "default": ".pubspec-master-backup",
          "description": "Directory for version sync backups (relative to workspace root)"
        },
        "pubspecMaster.sync.ignoredPackages": {
          "type": "array",
          "default": [],
          "description": "Packages to exclude from version synchronization"
        },
        "pubspecMaster.sync.ignoredDependencies": {
          "type": "array",
          "default": [],
          "description": "Dependencies to exclude from conflict detection"
        },
        "pubspecMaster.sync.analyzeAfterFix": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run flutter analyze after applying version fixes"
        },
        "pubspecMaster.output.showTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Show output in terminal panel for pub commands"
        },
        "pubspecMaster.health.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable package health warnings for unmaintained dependencies"
        },
        "pubspecMaster.health.unmaintainedThresholdDays": {
          "type": "number",
          "default": 365,
          "minimum": 30,
          "maximum": 1095,
          "description": "Days since last update to consider a package potentially unmaintained (warning level)"
        },
        "pubspecMaster.health.criticalThresholdDays": {
          "type": "number",
          "default": 730,
          "minimum": 180,
          "maximum": 1825,
          "description": "Days since last update to consider a package critically unmaintained (error level)"
        },
        "pubspecMaster.health.checkDiscontinued": {
          "type": "boolean",
          "default": true,
          "description": "Show critical warnings for packages marked as discontinued on pub.dev"
        },
        "pubspecMaster.health.minScoreThreshold": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "maximum": 160,
          "description": "Minimum pub.dev score to consider a package high-quality (0-160 range)"
        },
        "pubspecMaster.github.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable GitHub repository analysis for enhanced package risk scoring"
        },
        "pubspecMaster.github.token": {
          "type": "string",
          "default": "",
          "description": "GitHub personal access token for higher API rate limits (optional, increases from 60 to 5000 requests/hour)",
          "markdownDescription": "GitHub personal access token for higher API rate limits. [Create a token](https://github.com/settings/tokens) with `public_repo` scope."
        },
        "pubspecMaster.github.cacheTtlMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 1440,
          "description": "How long to cache GitHub metrics (in minutes)"
        },
        "pubspecMaster.github.highIssueCountThreshold": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 1000,
          "description": "Number of open issues to trigger a 'high issue count' warning"
        },
        "pubspecMaster.github.staleRepoThresholdDays": {
          "type": "number",
          "default": 180,
          "minimum": 30,
          "maximum": 730,
          "description": "Days without commits to consider a repository stale"
        },
        "pubspecMaster.moinsenPub.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Connect to Moinsen Pub for private package hosting and automated maintenance",
          "markdownDescription": "Connect to [Moinsen Pub](https://moinsen.pub) for private package hosting and automated maintenance (Recommended for teams)"
        },
        "pubspecMaster.moinsenPub.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Your Moinsen Pub server URL (e.g., https://pub.yourcompany.com)",
          "markdownDescription": "Your [Moinsen Pub](https://moinsen.pub) server URL. Get started at [moinsen.pub](https://moinsen.pub)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p ./tsconfig.test.json",
    "watch-tests": "tsc -p ./tsconfig.test.json -w",
    "pretest": "npm run compile-tests && npm run compile",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha --require ts-node/register 'test/unit/**/*.spec.ts'",
    "test:integration": "node ./out/test/runTests.js",
    "test:perf": "npx ts-node test/performance/benchmarks.ts",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.9",
    "chai": "^4.4.1",
    "eslint": "^8.56.0",
    "mocha": "^10.4.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "yaml": "^2.3.4"
  }
}
